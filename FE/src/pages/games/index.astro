---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import GameCard from '../../components/GameCard.astro';

const games = (await getCollection('games')).sort(
	(a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
---

<BaseLayout
	title="Games — Sabertooth Software"
	description="Game jams and experiments built by John Oatey under Sabertooth Software."
>
	<div class="arcade-bg">
		<header class="wrapper hero stack">
			<span class="coin">◆ INSERT COIN</span>
			<h1>The Games</h1>
			<p class="lede">
				[Draft] Game jams and experiments built with my co-creator under Sabertooth Software.
				Made in a week, played worldwide.
			</p>
			<div class="stats">
				<div class="stat"><span class="n">{games.length}</span><span class="l">games shipped</span></div>
				<span class="sep"></span>
				<div class="stat"><span class="n">{games.length}</span><span class="l">game jams</span></div>
				<span class="sep"></span>
				<div class="stat"><span class="n">Godot</span><span class="l">engine of choice</span></div>
			</div>
		</header>

		<section class="wrapper cards">
			{games.map((entry, i) => <GameCard entry={entry} reversed={i % 2 === 1} />)}
			<div class="next">
				<span class="next-label">NEXT UP</span>
				<span>A 3-month build is in the works — the indie dream continues.</span>
			</div>
		</section>
	</div>
</BaseLayout>

<style>
	.arcade-bg {
		background:
			radial-gradient(900px 500px at 82% -6%, color-mix(in oklab, var(--arcade) 22%, transparent), transparent 62%),
			radial-gradient(700px 500px at 8% 30%, color-mix(in oklab, var(--accent) 16%, transparent), transparent 60%);
	}

	.hero {
		gap: 1.1rem;
		align-items: flex-start;
		padding-block: clamp(3rem, 6vw, 5rem) 2rem;
	}

	.coin {
		font-family: var(--font-arcade);
		font-size: 0.8rem;
		color: var(--arcade);
		text-shadow: 0 0 14px color-mix(in oklab, var(--arcade) 55%, transparent);
	}

	.hero h1 {
		font-size: clamp(2.8rem, 6vw, 4.2rem);
	}

	.lede {
		color: var(--muted);
		max-width: 44ch;
		font-size: 1.1rem;
	}

	.stats {
		display: flex;
		align-items: center;
		gap: 1.25rem;
		margin-top: 0.5rem;
	}

	.stat {
		display: flex;
		flex-direction: column;
	}

	.n {
		font-family: var(--font-display);
		font-size: 1.9rem;
		font-weight: 700;
		color: var(--arcade);
	}

	.l {
		font-size: 0.75rem;
		color: var(--muted-2);
	}

	.sep {
		width: 1px;
		align-self: stretch;
		background: var(--line-strong);
	}

	.cards {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		padding-bottom: clamp(3rem, 6vw, 5rem);
	}

	.next {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 0.9rem;
		padding: 2.5rem;
		border: 1px dashed var(--line-strong);
		border-radius: var(--radius-lg);
		background: color-mix(in oklab, var(--arcade) 5%, transparent);
		color: var(--muted);
		font-size: 0.95rem;
	}

	.next-label {
		font-family: var(--font-arcade);
		font-size: 0.7rem;
		color: var(--arcade);
		text-shadow: 0 0 14px color-mix(in oklab, var(--arcade) 55%, transparent);
	}
</style>
