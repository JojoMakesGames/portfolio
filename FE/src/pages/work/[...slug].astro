---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactSection from '../../components/ContactSection.astro';

export async function getStaticPaths() {
	const work = await getCollection('work');
	return work.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

type Props = { entry: CollectionEntry<'work'> };
const { entry } = Astro.props;
const { title, description, tags, problem, approach, outcome, metrics, img, img_alt } = entry.data;
const { Content } = await render(entry);
---

<BaseLayout title={`${title} — John Oatey`} description={description}>
	<article>
		<header class="wrapper intro stack">
			<a class="back" href="/work/">← Work</a>
			<h1>{title}</h1>
			<div class="tags">
				{tags.map((t) => <span class="pill">{t}</span>)}
			</div>
			<p class="lede">{description}</p>
			{
				metrics.length > 0 && (
					<div class="metrics">
						{metrics.map((m) => (
							<div class="metric">
								<span class="value">{m.value}</span>
								<span class="label">{m.label}</span>
							</div>
						))}
					</div>
				)
			}
		</header>

		{img && <div class="wrapper hero-img"><img src={img} alt={img_alt || ''} /></div>}

		{
			(problem || approach || outcome) && (
				<div class="wrapper arc">
					{problem && (
						<section>
							<span class="eyebrow plain">Problem</span>
							<p>{problem}</p>
						</section>
					)}
					{approach && (
						<section>
							<span class="eyebrow plain">Approach</span>
							<p>{approach}</p>
						</section>
					)}
					{outcome && (
						<section>
							<span class="eyebrow plain">Outcome</span>
							<p>{outcome}</p>
						</section>
					)}
				</div>
			)
		}

		<div class="wrapper prose">
			<Content />
		</div>
	</article>

	<ContactSection />
</BaseLayout>

<style>
	.intro {
		gap: 1rem;
		padding-block: clamp(2.5rem, 5vw, 4rem) 1.5rem;
		align-items: flex-start;
	}

	.back {
		font-family: var(--font-mono);
		font-size: 0.8rem;
		color: var(--muted);
	}

	.intro h1 {
		font-size: clamp(2.1rem, 4.5vw, 3.25rem);
		max-width: 20ch;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.lede {
		font-size: 1.15rem;
		color: var(--muted);
		max-width: 54ch;
	}

	.metrics {
		display: flex;
		flex-wrap: wrap;
		gap: 2.5rem;
		margin-top: 0.75rem;
	}

	.metric {
		display: flex;
		flex-direction: column;
	}

	.value {
		font-family: var(--font-display);
		font-size: 2rem;
		font-weight: 700;
		color: var(--accent);
	}

	.label {
		font-size: 0.78rem;
		color: var(--muted-2);
	}

	.hero-img {
		margin-block: 1.5rem;
	}

	.hero-img img {
		width: 100%;
		border-radius: var(--radius);
		border: 1px solid var(--line);
	}

	.arc {
		display: grid;
		gap: 1.5rem;
		padding-block: 2rem;
	}

	.arc section {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.arc .eyebrow {
		color: var(--accent);
	}

	.arc p {
		color: var(--fg-body);
		max-width: 60ch;
	}

	.prose {
		max-width: 68ch;
		padding-block: 1.5rem 3.5rem;
	}

	.prose :global(h2),
	.prose :global(h3),
	.prose :global(h4) {
		margin-top: 2rem;
		margin-bottom: 0.75rem;
	}

	.prose :global(p),
	.prose :global(ul),
	.prose :global(ol) {
		margin-bottom: 1rem;
	}

	.prose :global(blockquote) {
		border-inline-start: 3px solid var(--accent);
		padding-inline-start: 1.25rem;
		color: var(--muted);
		font-style: italic;
	}

	.prose :global(a) {
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	@media (min-width: 48em) {
		.arc {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}
</style>
