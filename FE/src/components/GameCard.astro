---
import type { CollectionEntry } from 'astro:content';

interface Props {
	entry: CollectionEntry<'games'>;
	reversed?: boolean;
}

const { entry, reversed = false } = Astro.props;
const { title, description, engine, jamNumber, jamTheme, playUrl, sourceUrl, img, img_alt } =
	entry.data;
const badgeClass = jamNumber === 1 ? 'gold' : 'arcade';
---

<article class:list={['game', { reversed }]}>
	<a class="shot" href={`/games/${entry.id}/`}>
		{img ? <img src={img} alt={img_alt || ''} loading="lazy" /> : <span class="ph">[gameplay screenshot]</span>}
	</a>
	<div class="body">
		<div class="badges">
			{jamNumber && <span class:list={['jam', badgeClass]}>GAME JAM #{jamNumber}</span>}
			{engine && <span class="pill">{engine}</span>}
			{jamTheme && <span class="pill">Theme: {jamTheme}</span>}
		</div>
		<h2><a href={`/games/${entry.id}/`}>{title}</a></h2>
		<p>{description}</p>
		<div class="actions">
			{
				playUrl && (
					<a class="play" href={playUrl} target="_blank" rel="noopener">
						<svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
						Play on itch.io
					</a>
				)
			}
			{
				sourceUrl && (
					<a class="source" href={sourceUrl} target="_blank" rel="noopener">
						Source
					</a>
				)
			}
		</div>
	</div>
</article>

<style>
	.game {
		display: grid;
		grid-template-columns: 1fr;
		background: var(--surface);
		border: 1px solid var(--line-strong);
		border-radius: var(--radius-lg);
		overflow: hidden;
	}

	.shot {
		min-height: 220px;
		display: grid;
		place-items: center;
		background: linear-gradient(150deg, color-mix(in oklab, var(--arcade) 22%, var(--surface)), var(--surface));
	}

	.shot img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.ph {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		color: var(--muted-2);
	}

	.body {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		padding: 2rem;
	}

	.badges {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		align-items: center;
	}

	.jam {
		font-family: var(--font-arcade);
		font-size: 0.5rem;
		line-height: 1.4;
		color: var(--arcade-on);
		border-radius: 4px;
		padding: 0.4rem 0.55rem;
	}

	.jam.arcade {
		background: var(--arcade);
	}

	.jam.gold {
		background: var(--gold);
	}

	h2 {
		font-size: clamp(1.6rem, 3vw, 2.15rem);
	}

	h2 a {
		color: var(--fg);
	}

	.body p {
		font-size: 0.95rem;
		color: var(--muted);
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 0.25rem;
	}

	.play {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.7rem 1.2rem;
		border-radius: var(--radius-sm);
		background: var(--arcade);
		color: var(--arcade-on);
		font-weight: 600;
		font-size: 0.9rem;
	}

	.play:hover {
		color: var(--arcade-on);
		filter: brightness(1.05);
	}

	.source {
		display: inline-flex;
		align-items: center;
		padding: 0.7rem 1.2rem;
		border-radius: var(--radius-sm);
		border: 1px solid var(--line-strong);
		color: var(--fg);
		font-weight: 500;
		font-size: 0.9rem;
	}

	.source:hover {
		border-color: var(--arcade);
		color: var(--arcade);
	}

	@media (min-width: 52em) {
		.game {
			grid-template-columns: 1.1fr 1fr;
		}

		.game.reversed .shot {
			order: 2;
		}
	}
</style>
