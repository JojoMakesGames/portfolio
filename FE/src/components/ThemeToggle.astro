---
---

<theme-toggle>
	<button type="button" aria-pressed="false">
		<span class="sr-only">Toggle dark theme</span>
		<svg class="sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
		<svg class="moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
	</button>
</theme-toggle>

<style>
	button {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.2rem;
		height: 2.2rem;
		padding: 0;
		border: 1px solid var(--line-strong);
		border-radius: 999px;
		background: var(--surface);
		color: var(--muted);
		cursor: pointer;
		transition: color var(--theme-transition), border-color var(--theme-transition);
	}

	button:hover {
		color: var(--accent);
		border-color: var(--accent);
	}

	.moon {
		display: none;
	}

	:global(.theme-dark) .sun {
		display: none;
	}

	:global(.theme-dark) .moon {
		display: block;
	}
</style>

<script>
	class ThemeToggle extends HTMLElement {
		constructor() {
			super();
			const button = this.querySelector('button')!;
			const sync = () => button.setAttribute('aria-pressed', String(this.isDark()));
			button.addEventListener('click', () => {
				document.documentElement.classList.toggle('theme-dark');
				sync();
			});
			sync();
		}
		isDark() {
			return document.documentElement.classList.contains('theme-dark');
		}
	}
	customElements.define('theme-toggle', ThemeToggle);
</script>
