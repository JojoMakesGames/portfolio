---
import Icon, { Props as IconProps } from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
	arcade?: boolean;
}

const { arcade = false } = Astro.props;

const textLinks: { label: string; href: string }[] = [
	{ label: 'Work', href: '/work/' },
	{ label: 'Games', href: '/games/' },
	{ label: 'Writing', href: '/writing/' },
	{ label: 'About', href: '/' },
];

const iconLinks: { label: string; href: string; icon: IconProps['icon'] }[] = [
	{ label: 'LinkedIn', href: 'https://www.linkedin.com/in/john-oatey-7b558414a', icon: 'linkedin-logo' },
	{ label: 'GitHub', href: 'https://github.com/JojoMakesGames', icon: 'github-logo' },
];

const path = Astro.url.pathname;
const isActive = (href: string) =>
	href === '/' ? path === '/' : path === href || path.startsWith(href);
---

<nav class:list={['nav', { arcade }]}>
	<div class="menu-header">
		<a href="/" class="brand">
			<span class="mark">JO</span>
			<span class="brand-name">{arcade ? 'Sabertooth Software' : 'John Oatey'}</span>
		</a>
		<menu-button>
			<template>
				<button class="menu-button" aria-expanded="false">
					<span class="sr-only">Menu</span>
					<Icon icon="list" />
				</button>
			</template>
		</menu-button>
	</div>
	<div id="menu-content" class="menu-content">
		<ul class="nav-items">
			{
				textLinks.map(({ label, href }) => (
					<li>
						<a
							aria-current={isActive(href) ? 'page' : undefined}
							class:list={['link', { active: isActive(href) }]}
							href={href}
						>
							{label}
						</a>
					</li>
				))
			}
		</ul>
		<div class="menu-footer">
			<div class="socials">
				{
					iconLinks.map(({ href, icon, label }) => (
						<a href={href} class="social" target="_blank" rel="noopener">
							<span class="sr-only">{label}</span>
							<Icon icon={icon} />
						</a>
					))
				}
			</div>
			<ThemeToggle />
			<a class="cta" href="/#contact">
				Start a project
				<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path></svg>
			</a>
		</div>
	</div>
</nav>

<script>
	class MenuButton extends HTMLElement {
		constructor() {
			super();
			this.appendChild(this.querySelector('template')!.content.cloneNode(true));
			const btn = this.querySelector('button')!;
			const menu = document.getElementById('menu-content')!;
			menu.hidden = true;

			const setExpanded = (expand: boolean) => {
				btn.setAttribute('aria-expanded', expand ? 'true' : 'false');
				menu.hidden = !expand;
			};

			btn.addEventListener('click', () => setExpanded(menu.hidden));

			const handleViewports = (e: MediaQueryList | MediaQueryListEvent) => {
				setExpanded(e.matches);
				btn.hidden = e.matches;
			};
			const mq = window.matchMedia('(min-width: 50em)');
			handleViewports(mq);
			mq.addEventListener('change', handleViewports);
		}
	}
	customElements.define('menu-button', MenuButton);
</script>

<style>
	.nav {
		--nav-accent: var(--accent);
		--nav-on: var(--on-accent);
		position: relative;
		z-index: 50;
		font-family: var(--font-body);
		border-bottom: 1px solid var(--line-strong);
	}

	.nav.arcade {
		--nav-accent: var(--arcade);
		--nav-on: var(--arcade-on);
	}

	.menu-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 0.5rem;
		padding: 1.1rem var(--gutter);
	}

	.brand {
		display: flex;
		gap: 0.7rem;
		align-items: center;
		color: var(--fg);
	}

	.mark {
		display: grid;
		place-items: center;
		width: 34px;
		height: 34px;
		border-radius: var(--radius-sm);
		border: 1px solid var(--nav-accent);
		color: var(--nav-accent);
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 0.9rem;
	}

	.brand-name {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.menu-button {
		display: flex;
		border: 1px solid var(--line-strong);
		border-radius: 999px;
		padding: 0.5rem;
		font-size: 1.4rem;
		color: var(--fg);
		background: var(--surface);
		cursor: pointer;
	}

	.menu-button[hidden] {
		display: none;
	}

	.menu-content {
		border-bottom: 1px solid var(--line);
	}

	.nav-items {
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		padding: 1rem var(--gutter);
		margin: 0;
	}

	.link {
		display: inline-block;
		padding: 0.5rem 0.2rem;
		color: var(--muted);
		font-size: 0.95rem;
		transition: color var(--theme-transition);
	}

	.link:hover {
		color: var(--fg);
	}

	.link.active {
		color: var(--nav-accent);
	}

	.menu-footer {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 1rem;
		padding: 0 var(--gutter) 1.25rem;
	}

	.socials {
		display: flex;
		gap: 0.4rem;
		font-size: 1.3rem;
	}

	.social {
		display: flex;
		padding: 0.3rem;
		color: var(--muted);
	}

	.social:hover {
		color: var(--nav-accent);
	}

	.cta {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.55rem 1.1rem;
		border-radius: var(--radius-sm);
		background: var(--nav-accent);
		color: var(--nav-on);
		font-weight: 600;
		font-size: 0.9rem;
	}

	.cta:hover {
		color: var(--nav-on);
		filter: brightness(1.05);
	}

	@media (min-width: 50em) {
		.nav {
			display: flex;
			align-items: center;
			justify-content: space-between;
			padding: 0.4rem var(--gutter);
		}

		.menu-header {
			padding: 0.8rem 0;
		}

		.menu-content {
			display: flex;
			align-items: center;
			gap: 2rem;
			border: 0;
		}

		.nav-items {
			flex-direction: row;
			gap: 2rem;
			padding: 0;
		}

		.link {
			padding: 0.3rem 0;
		}

		.menu-footer {
			padding: 0;
			gap: 1.25rem;
		}
	}
</style>
