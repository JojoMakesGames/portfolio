---
const items = [
	{
		title: 'Automate the busywork',
		body:
			'[Draft] Replace copy-paste, spreadsheets, and hand-offs with workflows that run on their own.',
		icon:
			'<path d="M13 2 3 14h7l-1 8 10-12h-7z"/>',
	},
	{
		title: 'Cut the error rate',
		body: '[Draft] Fewer manual touch-points means fewer mistakes reaching your customers.',
		icon: '<path d="M12 3l7 3v5c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6z"/><path d="m9 12 2 2 4-4"/>',
	},
	{
		title: 'Modernize stale process',
		body:
			'[Draft] Bring aging, undocumented workflows into something your team can actually own.',
		icon:
			'<path d="M3 12a9 9 0 0 1 15-6.7L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-15 6.7L3 16"/><path d="M3 21v-5h5"/>',
	},
];
---

<div class="head">
	<span class="eyebrow">01 / What I do</span>
	<span class="rule"></span>
</div>
<div class="grid">
	{
		items.map((item) => (
			<article class="pillar">
				<span class="ico">
					<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" set:html={item.icon} />
				</span>
				<h3>{item.title}</h3>
				<p>{item.body}</p>
			</article>
		))
	}
</div>

<style>
	.head {
		display: flex;
		align-items: center;
		gap: 0.9rem;
		margin-bottom: 2rem;
	}

	.head .eyebrow {
		color: var(--muted);
	}

	.head .eyebrow::before {
		display: none;
	}

	.rule {
		flex: 1;
		height: 1px;
		background: var(--line-strong);
	}

	.grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.25rem;
	}

	.pillar {
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
		padding: 1.75rem;
		background: var(--inset);
		border: 1px solid var(--line);
		border-radius: var(--radius);
	}

	.ico {
		display: grid;
		place-items: center;
		width: 44px;
		height: 44px;
		border-radius: 11px;
		background: var(--surface-2);
		border: 1px solid var(--line-strong);
		color: var(--accent);
	}

	.pillar h3 {
		font-size: 1.25rem;
		font-weight: 600;
	}

	.pillar p {
		font-size: 0.95rem;
		color: var(--muted);
	}

	@media (min-width: 48em) {
		.grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}
</style>
